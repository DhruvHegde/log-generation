2026-07-01T20:36:54.6403013Z     def test_file_response(tmp_path: Path, test_client_factory: TestClientFactory) -> None:
2026-07-01T20:36:54.6403113Z         path = tmp_path / "xyz"
2026-07-01T20:36:54.6403213Z         content = b"<file content>" * 1000
2026-07-01T20:36:54.6403317Z         path.write_bytes(content)
2026-07-01T20:36:54.6403396Z     
2026-07-01T20:36:54.6403485Z         filled_by_bg_task = ""
2026-07-01T20:36:54.6403567Z     
2026-07-01T20:36:54.6403762Z         async def numbers(minimum: int, maximum: int) -> AsyncIterator[str]:
2026-07-01T20:36:54.6403870Z             for i in range(minimum, maximum + 1):
2026-07-01T20:36:54.6403963Z                 yield str(i)
2026-07-01T20:36:54.6404048Z                 if i != maximum:
2026-07-01T20:36:54.6404135Z                     yield ", "
2026-07-01T20:36:54.6404274Z                 await anyio.sleep(0)
2026-07-01T20:36:54.6404348Z     
2026-07-01T20:36:54.6404538Z         async def numbers_for_cleanup(start: int = 1, stop: int = 5) -> None:
2026-07-01T20:36:54.6404636Z             nonlocal filled_by_bg_task
2026-07-01T20:36:54.6404754Z             async for thing in numbers(start, stop):
2026-07-01T20:36:54.6404890Z                 filled_by_bg_task = filled_by_bg_task + thing
2026-07-01T20:36:54.6404967Z     
2026-07-01T20:36:54.6405163Z         cleanup_task = BackgroundTask(numbers_for_cleanup, start=6, stop=9)
2026-07-01T20:36:54.6405280Z     
2026-07-01T20:36:54.6405607Z         async def app(scope: Scope, receive: Receive, send: Send) -> None:
2026-07-01T20:36:54.6405869Z             response = FileResponse(path=path, filename="example.png", background=cleanup_task)
2026-07-01T20:36:54.6405987Z             await response(scope, receive, send)
2026-07-01T20:36:54.6406059Z     
2026-07-01T20:36:54.6406193Z         assert filled_by_bg_task == ""
2026-07-01T20:36:54.6406291Z         client = test_client_factory(app)
2026-07-01T20:36:54.6406390Z >       response = client.get("/")
