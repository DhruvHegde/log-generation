2026-07-01T20:36:54.9750199Z                 "myvalue",
2026-07-01T20:36:54.9750351Z                 path="/",
2026-07-01T20:36:54.9750523Z                 domain=domain,
2026-07-01T20:36:54.9750653Z             )
2026-07-01T20:36:54.9750864Z             await response(scope, receive, send)
