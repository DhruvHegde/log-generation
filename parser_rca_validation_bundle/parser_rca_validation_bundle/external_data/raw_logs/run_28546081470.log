2026-07-01T20:36:54.1071264Z                         if message["type"] == "http.disconnect":  # pragma: no branch
2026-07-01T20:36:54.1071664Z                             task_group.cancel_scope.cancel()
2026-07-01T20:36:54.1071964Z                             break
2026-07-01T20:36:54.1072187Z     
2026-07-01T20:36:54.1072417Z                 # Using start instead of start_soon to ensure that
2026-07-01T20:36:54.1072797Z                 # cancel_on_disconnect is scheduled by the event loop
