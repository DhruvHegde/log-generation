2026-07-01T20:36:54.6013728Z             request = Request(scope, receive)
2026-07-01T20:36:54.6013888Z             response = JSONResponse({"cookies": request.cookies})
2026-07-01T20:36:54.6013999Z             await response(scope, receive, send)
