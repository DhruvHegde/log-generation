2026-07-01T20:36:54.5554022Z     def test_cookie_lenient_parsing(test_client_factory: TestClientFactory) -> None:
2026-07-01T20:36:54.5554102Z         """
2026-07-01T20:36:54.5554359Z         The following test is based on a cookie set by Okta, a well-known authorization
2026-07-01T20:36:54.5554562Z         service. It turns out that it's common practice to set cookies that would be
2026-07-01T20:36:54.5554666Z         invalid according to the spec.
2026-07-01T20:36:54.5554743Z         """
2026-07-01T20:36:54.5554827Z         tough_cookie = (
2026-07-01T20:36:54.5554963Z             "provider-oauth-nonce=validAsciiblabla; "
2026-07-01T20:36:54.5555172Z             'okta-oauth-redirect-params={"responseType":"code","state":"somestate",'
2026-07-01T20:36:54.5555507Z             '"nonce":"somenonce","scopes":["openid","profile","email","phone"],'
2026-07-01T20:36:54.5555709Z             '"urls":{"issuer":"https://subdomain.okta.com/oauth2/authServer",'
2026-07-01T20:36:54.5555936Z             '"authorizeUrl":"https://subdomain.okta.com/oauth2/authServer/v1/authorize",'
2026-07-01T20:36:54.5556170Z             '"userinfoUrl":"https://subdomain.okta.com/oauth2/authServer/v1/userinfo"}}; '
2026-07-01T20:36:54.5556388Z             "importantCookie=importantValue; sessionCookie=importantSessionValue"
2026-07-01T20:36:54.5556462Z         )
2026-07-01T20:36:54.5556554Z         expected_keys = {
2026-07-01T20:36:54.5556715Z             "importantCookie",
2026-07-01T20:36:54.5556825Z             "okta-oauth-redirect-params",
2026-07-01T20:36:54.5556926Z             "provider-oauth-nonce",
2026-07-01T20:36:54.5557017Z             "sessionCookie",
2026-07-01T20:36:54.5557095Z         }
2026-07-01T20:36:54.5557168Z     
2026-07-01T20:36:54.5557345Z         async def app(scope: Scope, receive: Receive, send: Send) -> None:
2026-07-01T20:36:54.5557453Z             request = Request(scope, receive)
2026-07-01T20:36:54.5557599Z             response = JSONResponse({"cookies": request.cookies})
2026-07-01T20:36:54.5557715Z             await response(scope, receive, send)
2026-07-01T20:36:54.5557852Z     
2026-07-01T20:36:54.5557951Z         client = test_client_factory(app)
2026-07-01T20:36:54.5558119Z >       response = client.get("/", headers={"cookie": tough_cookie})
2026-07-01T20:36:54.5558233Z                    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
