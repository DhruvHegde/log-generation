2026-07-01T20:36:54.0894401Z     def test_contextvars(
2026-07-01T20:36:54.0894881Z         test_client_factory: TestClientFactory,
2026-07-01T20:36:54.0895685Z         middleware_cls: _MiddlewareFactory[Any],
2026-07-01T20:36:54.0896215Z     ) -> None:
2026-07-01T20:36:54.0896787Z         # this has to be an async endpoint because Starlette calls run_in_threadpool
2026-07-01T20:36:54.0897734Z         # on sync endpoints which has it's own set of peculiarities w.r.t propagating
2026-07-01T20:36:54.0898606Z         # contextvars (it propagates them forwards but not backwards)
2026-07-01T20:36:54.0899351Z         async def homepage(request: Request) -> PlainTextResponse:
2026-07-01T20:36:54.0899996Z             assert ctxvar.get() == "set by middleware"
2026-07-01T20:36:54.0900516Z             ctxvar.set("set by endpoint")
2026-07-01T20:36:54.0901016Z             return PlainTextResponse("Homepage")
2026-07-01T20:36:54.0901512Z     
