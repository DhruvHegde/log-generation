2026-07-01T20:36:54.6965587Z             cleanup_task = BackgroundTask(numbers_for_cleanup, start=6, stop=9)
2026-07-01T20:36:54.6965687Z             generator = numbers(1, 5)
2026-07-01T20:36:54.6965973Z             response = StreamingResponse(generator, media_type="text/plain", background=cleanup_task)
