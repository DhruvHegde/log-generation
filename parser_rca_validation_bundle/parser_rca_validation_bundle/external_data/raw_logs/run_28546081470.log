2026-07-01T20:36:54.7036211Z 
2026-07-01T20:36:54.7036472Z     def test_file_response(tmp_path: Path, test_client_factory: TestClientFactory) -> None:
2026-07-01T20:36:54.7036572Z         path = tmp_path / "xyz"
2026-07-01T20:36:54.7036671Z         content = b"<file content>" * 1000
2026-07-01T20:36:54.7036771Z         path.write_bytes(content)
2026-07-01T20:36:54.7036853Z     
2026-07-01T20:36:54.7036942Z         filled_by_bg_task = ""
2026-07-01T20:36:54.7037080Z     
2026-07-01T20:36:54.7037272Z         async def numbers(minimum: int, maximum: int) -> AsyncIterator[str]:
2026-07-01T20:36:54.7037387Z             for i in range(minimum, maximum + 1):
2026-07-01T20:36:54.7037480Z                 yield str(i)
2026-07-01T20:36:54.7037568Z                 if i != maximum:
2026-07-01T20:36:54.7037656Z                     yield ", "
2026-07-01T20:36:54.7037754Z                 await anyio.sleep(0)
2026-07-01T20:36:54.7037827Z     
2026-07-01T20:36:54.7038018Z         async def numbers_for_cleanup(start: int = 1, stop: int = 5) -> None:
2026-07-01T20:36:54.7038113Z             nonlocal filled_by_bg_task
2026-07-01T20:36:54.7038237Z             async for thing in numbers(start, stop):
2026-07-01T20:36:54.7038376Z                 filled_by_bg_task = filled_by_bg_task + thing
2026-07-01T20:36:54.7038447Z     
2026-07-01T20:36:54.7038643Z         cleanup_task = BackgroundTask(numbers_for_cleanup, start=6, stop=9)
2026-07-01T20:36:54.7038721Z     
2026-07-01T20:36:54.7038902Z         async def app(scope: Scope, receive: Receive, send: Send) -> None:
2026-07-01T20:36:54.7039161Z             response = FileResponse(path=path, filename="example.png", background=cleanup_task)
2026-07-01T20:36:54.7039332Z             await response(scope, receive, send)
2026-07-01T20:36:54.7039415Z     
2026-07-01T20:36:54.7039518Z         assert filled_by_bg_task == ""
2026-07-01T20:36:54.7039615Z         client = test_client_factory(app)
2026-07-01T20:36:54.7039719Z >       response = client.get("/")
2026-07-01T20:36:54.7039803Z                    ^^^^^^^^^^^^^^^
