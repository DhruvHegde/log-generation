2026-07-01T20:36:54.5567725Z 
2026-07-01T20:36:54.5567824Z     @pytest.mark.parametrize(
2026-07-01T20:36:54.5567921Z         "set_cookie,expected",
2026-07-01T20:36:54.5567997Z         [
2026-07-01T20:36:54.5568176Z             ("chips=ahoy; vienna=finger", {"chips": "ahoy", "vienna": "finger"}),
2026-07-01T20:36:54.5568327Z             # all semicolons are delimiters, even within quotes
2026-07-01T20:36:54.5568408Z             (
2026-07-01T20:36:54.5568532Z                 'keebler="E=mc2; L=\\"Loves\\"; fudge=\\012;"',
2026-07-01T20:36:54.5568760Z                 {"keebler": '"E=mc2', "L": '\\"Loves\\"', "fudge": "\\012", "": '"'},
2026-07-01T20:36:54.5568835Z             ),
2026-07-01T20:36:54.5569001Z             # Illegal cookies that have an '=' char in an unquoted value.
2026-07-01T20:36:54.5569117Z             ("keebler=E=mc2", {"keebler": "E=mc2"}),
2026-07-01T20:36:54.5569235Z             # Cookies with ':' character in their name.
2026-07-01T20:36:54.5569374Z             ("key:term=value:term", {"key:term": "value:term"}),
2026-07-01T20:36:54.5569473Z             # Cookies with '[' and ']'.
2026-07-01T20:36:54.5569613Z             ("a=b; c=[; d=r; f=h", {"a": "b", "c": "[", "d": "r", "f": "h"}),
2026-07-01T20:36:54.5569712Z             # Cookies that RFC6265 allows.
2026-07-01T20:36:54.5569875Z             ("a=b; Domain=example.com", {"a": "b", "Domain": "example.com"}),
2026-07-01T20:36:54.5570052Z             # parse_cookie() keeps only the last cookie with the same name.
2026-07-01T20:36:54.5570159Z             ("a=b; h=i; a=c", {"a": "c", "h": "i"}),
2026-07-01T20:36:54.5570235Z         ],
2026-07-01T20:36:54.5570313Z     )
2026-07-01T20:36:54.5570414Z     def test_cookies_edge_cases(
2026-07-01T20:36:54.5570499Z         set_cookie: str,
