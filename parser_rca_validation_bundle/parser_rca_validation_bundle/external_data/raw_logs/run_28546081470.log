2026-07-01T20:36:54.5571143Z             request = Request(scope, receive)
2026-07-01T20:36:54.5571298Z             response = JSONResponse({"cookies": request.cookies})
2026-07-01T20:36:54.5571411Z             await response(scope, receive, send)
2026-07-01T20:36:54.5571485Z     
