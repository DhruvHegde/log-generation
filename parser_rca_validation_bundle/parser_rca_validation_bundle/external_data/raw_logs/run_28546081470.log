2026-07-01T20:36:54.1067511Z                     "headers": [
2026-07-01T20:36:54.1067778Z                         (b"content-type", b"text/plain"),
2026-07-01T20:36:54.1068064Z                     ],
2026-07-01T20:36:54.1068260Z                 }
2026-07-01T20:36:54.1068450Z             )
2026-07-01T20:36:54.1068697Z             async with anyio.create_task_group() as task_group:
2026-07-01T20:36:54.1069000Z     
2026-07-01T20:36:54.1069203Z                 async def cancel_on_disconnect(
2026-07-01T20:36:54.1069481Z                     *,
2026-07-01T20:36:54.1069776Z                     task_status: TaskStatus[None] = anyio.TASK_STATUS_IGNORED,
2026-07-01T20:36:54.1070125Z                 ) -> None:
2026-07-01T20:36:54.1070372Z                     task_status.started()
2026-07-01T20:36:54.1070644Z                     while True:
