2026-07-01T20:36:54.6964050Z             async def numbers(minimum: int, maximum: int) -> AsyncIterator[str]:
2026-07-01T20:36:54.6964170Z                 for i in range(minimum, maximum + 1):
2026-07-01T20:36:54.6964261Z                     yield str(i)
2026-07-01T20:36:54.6964350Z                     if i != maximum:
2026-07-01T20:36:54.6964442Z                         yield ", "
