2026-07-01T20:36:54.5997766Z             '"nonce":"somenonce","scopes":["openid","profile","email","phone"],'
2026-07-01T20:36:54.5997959Z             '"urls":{"issuer":"https://subdomain.okta.com/oauth2/authServer",'
2026-07-01T20:36:54.5998186Z             '"authorizeUrl":"https://subdomain.okta.com/oauth2/authServer/v1/authorize",'
2026-07-01T20:36:54.5998510Z             '"userinfoUrl":"https://subdomain.okta.com/oauth2/authServer/v1/userinfo"}}; '
2026-07-01T20:36:54.5998733Z             "importantCookie=importantValue; sessionCookie=importantSessionValue"
2026-07-01T20:36:54.5998808Z         )
2026-07-01T20:36:54.5998904Z         expected_keys = {
2026-07-01T20:36:54.5998996Z             "importantCookie",
2026-07-01T20:36:54.5999115Z             "okta-oauth-redirect-params",
2026-07-01T20:36:54.5999220Z             "provider-oauth-nonce",
2026-07-01T20:36:54.5999309Z             "sessionCookie",
2026-07-01T20:36:54.5999388Z         }
2026-07-01T20:36:54.5999462Z     
