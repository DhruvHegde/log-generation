2026-07-01T20:36:54.9062604Z     def test_use_testclient_as_contextmanager(test_client_factory: TestClientFactory, anyio_backend_name: str) -> None:
2026-07-01T20:36:54.9062872Z         """
2026-07-01T20:36:54.9063280Z         This test asserts a number of properties that are important for an
2026-07-01T20:36:54.9063578Z         app level task_group
2026-07-01T20:36:54.9063835Z         """
2026-07-01T20:36:54.9064101Z         counter = itertools.count()
2026-07-01T20:36:54.9064570Z         identity_runvar = anyio.lowlevel.RunVar[int]("identity_runvar")
2026-07-01T20:36:54.9064763Z     
2026-07-01T20:36:54.9065025Z         def get_identity() -> int:
2026-07-01T20:36:54.9065249Z             try:
2026-07-01T20:36:54.9065702Z                 return identity_runvar.get()
2026-07-01T20:36:54.9066038Z             except LookupError:
2026-07-01T20:36:54.9066319Z                 token = next(counter)
2026-07-01T20:36:54.9066692Z                 identity_runvar.set(token)
2026-07-01T20:36:54.9066939Z                 return token
2026-07-01T20:36:54.9067107Z     
2026-07-01T20:36:54.9067427Z         startup_task = object()
2026-07-01T20:36:54.9067699Z         startup_loop = None
2026-07-01T20:36:54.9067906Z         shutdown_task = object()
2026-07-01T20:36:54.9068154Z         shutdown_loop = None
2026-07-01T20:36:54.9068323Z     
2026-07-01T20:36:54.9068663Z         @asynccontextmanager
2026-07-01T20:36:54.9069163Z         async def lifespan_context(app: Starlette) -> AsyncGenerator[None, None]:
2026-07-01T20:36:54.9069546Z             nonlocal startup_task, startup_loop, shutdown_task, shutdown_loop
2026-07-01T20:36:54.9069767Z     
2026-07-01T20:36:54.9070013Z             startup_task = current_task()
2026-07-01T20:36:54.9070284Z             startup_loop = get_identity()
2026-07-01T20:36:54.9070603Z             async with anyio.create_task_group():
2026-07-01T20:36:54.9070784Z                 yield
2026-07-01T20:36:54.9071058Z             shutdown_task = current_task()
2026-07-01T20:36:54.9071300Z             shutdown_loop = get_identity()
2026-07-01T20:36:54.9071579Z     
2026-07-01T20:36:54.9071957Z         async def loop_id(request: Request) -> JSONResponse:
2026-07-01T20:36:54.9073033Z             return JSONResponse(get_identity())
2026-07-01T20:36:54.9073216Z     
2026-07-01T20:36:54.9073443Z         app = Starlette(
2026-07-01T20:36:54.9073740Z             lifespan=lifespan_context,
