2026-07-01T20:36:54.6010339Z     @pytest.mark.parametrize(
2026-07-01T20:36:54.6010439Z         "set_cookie,expected",
2026-07-01T20:36:54.6010520Z         [
2026-07-01T20:36:54.6010706Z             ("chips=ahoy; vienna=finger", {"chips": "ahoy", "vienna": "finger"}),
2026-07-01T20:36:54.6010856Z             # all semicolons are delimiters, even within quotes
2026-07-01T20:36:54.6010931Z             (
2026-07-01T20:36:54.6011066Z                 'keebler="E=mc2; L=\\"Loves\\"; fudge=\\012;"',
2026-07-01T20:36:54.6011238Z                 {"keebler": '"E=mc2', "L": '\\"Loves\\"', "fudge": "\\012", "": '"'},
2026-07-01T20:36:54.6011314Z             ),
2026-07-01T20:36:54.6011486Z             # Illegal cookies that have an '=' char in an unquoted value.
2026-07-01T20:36:54.6011663Z             ("keebler=E=mc2", {"keebler": "E=mc2"}),
2026-07-01T20:36:54.6011786Z             # Cookies with ':' character in their name.
2026-07-01T20:36:54.6011929Z             ("key:term=value:term", {"key:term": "value:term"}),
2026-07-01T20:36:54.6012022Z             # Cookies with '[' and ']'.
2026-07-01T20:36:54.6012172Z             ("a=b; c=[; d=r; f=h", {"a": "b", "c": "[", "d": "r", "f": "h"}),
2026-07-01T20:36:54.6012275Z             # Cookies that RFC6265 allows.
2026-07-01T20:36:54.6012439Z             ("a=b; Domain=example.com", {"a": "b", "Domain": "example.com"}),
2026-07-01T20:36:54.6012620Z             # parse_cookie() keeps only the last cookie with the same name.
2026-07-01T20:36:54.6012775Z             ("a=b; h=i; a=c", {"a": "c", "h": "i"}),
2026-07-01T20:36:54.6012854Z         ],
2026-07-01T20:36:54.6012934Z     )
2026-07-01T20:36:54.6013030Z     def test_cookies_edge_cases(
