2026-07-01T20:36:54.1436451Z     def test_app_receives_http_disconnect_while_sending_if_discarded(
2026-07-01T20:36:54.1436567Z         test_client_factory: TestClientFactory,
2026-07-01T20:36:54.1436647Z     ) -> None:
2026-07-01T20:36:54.1436793Z         class DiscardingMiddleware(BaseHTTPMiddleware):
2026-07-01T20:36:54.1436885Z             async def dispatch(
2026-07-01T20:36:54.1436967Z                 self,
2026-07-01T20:36:54.1437054Z                 request: Request,
2026-07-01T20:36:54.1437142Z                 call_next: Any,
2026-07-01T20:36:54.1437240Z             ) -> PlainTextResponse:
2026-07-01T20:36:54.1437454Z                 # As a matter of ordering, this test targets the case where the downstream
2026-07-01T20:36:54.1437641Z                 # app response is discarded while it is sending a response body.
2026-07-01T20:36:54.1437842Z                 # We need to wait for the downstream app to begin sending a response body
2026-07-01T20:36:54.1438069Z                 # before sending the middleware response that will overwrite the downstream
2026-07-01T20:36:54.1438164Z                 # response.
2026-07-01T20:36:54.1438315Z                 downstream_app_response = await call_next(request)
2026-07-01T20:36:54.1438470Z                 body_generator = downstream_app_response.body_iterator
2026-07-01T20:36:54.1438552Z                 try:
2026-07-01T20:36:54.1438665Z                     await body_generator.__anext__()
2026-07-01T20:36:54.1438749Z                 finally:
2026-07-01T20:36:54.1438861Z                     await body_generator.aclose()
2026-07-01T20:36:54.1438933Z     
2026-07-01T20:36:54.1439050Z                 return PlainTextResponse("Custom")
2026-07-01T20:36:54.1439125Z     
