2026-09-18T02:19:43.4564760Z           "starred_url": "https://api.github.com/users/fastapi/starred{/owner}{/repo}",
2026-09-18T02:19:43.4565440Z           "subscriptions_url": "https://api.github.com/users/fastapi/subscriptions",
2026-09-18T02:19:43.4565970Z           "type": "Organization",
2026-09-18T02:19:43.4566440Z           "url": "https://api.github.com/users/fastapi",
