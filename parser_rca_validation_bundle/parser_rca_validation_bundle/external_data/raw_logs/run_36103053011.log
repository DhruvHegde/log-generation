2026-09-25T06:29:17.9644830Z           "starred_url": "https://api.github.com/users/fastapi/starred{/owner}{/repo}",
2026-09-25T06:29:17.9645530Z           "subscriptions_url": "https://api.github.com/users/fastapi/subscriptions",
