2026-09-09T14:58:11.6542610Z           "starred_url": "https://api.github.com/users/fastapi/starred{/owner}{/repo}",
2026-09-09T14:58:11.6543390Z           "subscriptions_url": "https://api.github.com/users/fastapi/subscriptions",
