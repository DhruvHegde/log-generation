          "node_id": "O_kgDOCVHG-A",
          "organizations_url": "https://api.github.com/users/fastapi/orgs",
          "received_events_url": "https://api.github.com/users/fastapi/received_events",
          "repos_url": "https://api.github.com/users/fastapi/repos",
          "site_admin": false,
